# yka_ikiiki_record Local .gitignore
# Repository-specific ignore rules

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/vite/node_modules
/packages/ui/node_modules

/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI Hub chain checkpoints
chain_checkpoints/

# AI Hub audit results (auto-generated)
.audit/

# AI Hub monitoring reports (auto-generated by tools/monitoring/llm_analyzer.py
# in ai-hub; the writer targets ~/yka_ikiiki_record/data/ and would otherwise
# leave the checkout dirty, which aborts the TAS self-push lane)
data/llm_analysis_*.md
